      "mcp__chrome-devtools__select_page",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__get_console_message",
      "mcp__chrome-devtools__list_network_requests",
      "mcp__chrome-devtools__get_network_request",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__wait_for",
      "mcp__chrome-devtools__performance_start_trace",
      "mcp__chrome-devtools__performance_stop_trace",
      "mcp__chrome-devtools__performance_analyze_insight",
      "mcp__chrome-devtools__navigate_page"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(/usr/bin/curl *)",
      "Bash(/usr/bin/wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(security *)",
      "Bash(gh auth token)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(git show *:.env)",
      "Bash(git show *:.env.*)",
      "Bash(grep *.env*)",
      "Bash(grep */.env*)",
      "Bash(grep *secrets/*)",
      "Bash(grep */.ssh/*)",
      "Bash(grep */.aws/*)",
      "Bash(grep *.git-credentials*)",
      "Bash(grep *.npmrc*)",
      "Bash(grep *.netrc*)",
      "Bash(find */.env*)",
      "Bash(find */.ssh/*)",
      "Bash(find */.aws/*)",
      "Bash(find *secrets/*)",
      "Bash(find *.git-credentials*)",
      "Bash(find *.npmrc*)",
      "Bash(find *.netrc*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm ci *)",
      "Bash(npm publish *)",
      "Bash(yarn add *)",
      "Bash(yarn install *)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(brew install *)",
      "Bash(brew uninstall *)",
      "Bash(docker run *)",
      "Bash(docker build *)",
      "Bash(gh pr merge *)",
      "Bash(gh issue create *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh \"Claude attend votre réponse\""
          }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh \"Claude demande une permission\""
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh \"Claude vous pose une question\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/notify.sh \"Tâche terminée\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude-glance/hooks/hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash $HOME/.claude-glance/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "mcp-apps@mcp-apps": true,
    "claude-md-management@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "teammateMode": "tmux"
}

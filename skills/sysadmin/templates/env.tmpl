# /opt/{{PROJECT_SLUG}}/.env  -  chmod 600, owned by deploy
# This file is the single source of truth for runtime config on the VPS.
# DO NOT commit. Regenerate secrets via openssl, store in your password manager.

APP_IMAGE={{IMAGE_REF}}:sha-<initial-sha>

# Caddy : hostnames servis. Accepte une liste separee par des virgules (cohabitation
# preview + apex pendant une migration DNS, cf. specs/seo-migration.md §J-1).
# Exemples :
#   SITE_ADDRESS={{PREVIEW_HOST}}                                   (preview seul)
#   SITE_ADDRESS={{PREVIEW_HOST}}, {{DOMAIN_APEX}}, www.{{DOMAIN_APEX}}   (J-1 cohabitation)
#   SITE_ADDRESS={{DOMAIN_APEX}}, www.{{DOMAIN_APEX}}                     (post go-live)
SITE_ADDRESS={{PREVIEW_HOST}}

# SEO : URL canonique exposee aux robots / sitemap / OG / canonical / JSON-LD.
# DOIT correspondre EXACTEMENT au hostname public actuel (avec scheme, sans slash final).
# - Sur le serveur preview : https://{{PREVIEW_HOST}} -> robots.txt sert "Disallow: /",
#   sitemap.xml vide, redirects 301 desactives, canonical pointe vers preview.
# - Au go-live, basculer vers https://{{DOMAIN_APEX}} (cf. specs/seo-migration.md §J0).
# Le code app (lib/seo.ts, app/robots.ts, app/sitemap.ts, next.config.ts redirects)
# distingue prod / preview en comparant cette valeur a la constante PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://{{PREVIEW_HOST}}
{{#if HAS_DB}}

POSTGRES_USER={{PROJECT_SLUG}}
# IMPORTANT: alphanum strict only. Special chars (/, +, =) break Postgres URL parsing.
# Generate: openssl rand -base64 64 | tr -dc 'A-Za-z0-9' | head -c 32
POSTGRES_PASSWORD=<32 chars alphanum>
POSTGRES_DB={{PROJECT_SLUG}}
DATABASE_URL=postgresql://{{PROJECT_SLUG}}:<password>@db:5432/{{PROJECT_SLUG}}
{{/if HAS_DB}}

AUTH_SECRET=<openssl rand -base64 32>
{{#if HAS_ADMIN_BOOTSTRAP}}

ADMIN_PSEUDO={{ADMIN_PSEUDO}}
ADMIN_PASSWORD=<20+ chars, generated via password manager>
{{/if HAS_ADMIN_BOOTSTRAP}}
